{
  "name": "help-desk-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Help Desk REST API (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "test": "node --import ./test/setup.js --test --test-concurrency=1 test/*.test.js",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:demo": "node scripts/seed-demo.js",
    "check:categories": "node scripts/check-categories.js",
    "create:staff": "node scripts/create-staff.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
