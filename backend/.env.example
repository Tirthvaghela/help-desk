# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=4000

# MongoDB connection string (local MongoDB or an Atlas URI). Always name the database after
# the host (…/helpdesk, or for Atlas …mongodb.net/helpdesk?retryWrites=true). Without a name
# MongoDB uses "test": the server warns in development and refuses to start in production.
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk

# Optional: database used by `npm test`. It must be local and its name must end in _test. Set it in the shell, not in
# .env: the test setup reads it before dotenv loads this file, so a value here has no effect.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/helpdesk_test

# Optional: production turns on the strict checks (secret, database name, email transport).
# NODE_ENV=production

# Secret used to sign login tokens. Use a long random string in real environments.
# With NODE_ENV=production the server refuses to start if it is shorter than 32 characters
# or still this placeholder.
JWT_SECRET=replace-with-a-long-random-string

# Login token lifetime, e.g. 1d or 12h (optional, default 1d; contract C-3 is still open)
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS; also the base for links in emails
CLIENT_URL=http://localhost:5173

# Optional: more frontend origins allowed by CORS, comma-separated exact origins (no paths,
# no "*"), e.g. a second dev server. Email links still use CLIENT_URL.
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5173

# Optional: sign-in/sign-up attempts per client IP per window (0 turns limiting off).
# Defaults: 20 per 15 minutes.
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# Optional: password-reset requests, reset-link attempts and password/email changes per IP.
# SENSITIVE_RATE_LIMIT_MAX=5

# --- Email (password reset, email-change confirmation, security notices) ---
# EMAIL_TRANSPORT: smtp | outbox | memory | disabled
#   Default in development: outbox (emails are written to backend/.outbox/, nothing is sent)
#   Default in production:  smtp (SMTP_HOST and EMAIL_FROM are then required)
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM="Help Desk <no-reply@your-domain.example>"
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# (SMTP_USERNAME / SMTP_PASSWORD are accepted as alternative names.)
# Folder for EMAIL_TRANSPORT=outbox. Leave unset to use backend/.outbox.
# EMAIL_OUTBOX_DIR=

# Link lifetimes
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_CHANGE_TTL_HOURS=24

# SLA: resolution target per priority, in whole calendar hours (1 to 8760).
# Each new ticket is due this long after it is created. Defaults shown.
# SLA_HOURS_HIGH=24
# SLA_HOURS_MEDIUM=72
# SLA_HOURS_LOW=168
